{
  "name": "app-functions-cli-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Template to create App Functions with Salla CLI.",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "postinstall": "npm install -g @salla.sa/cli",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --cache .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@salla.sa/cli": "3.2.30",
    "@salla.sa/app-functions-types": "^0.4.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
